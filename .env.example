# Environment Variables Reference
# Copy this file to .env or .env.local and fill in your values
# NEVER commit .env to git!

# ============================================================================
# CORE ENCRYPTION (REQUIRED FOR ALL OPTIONS)
# ============================================================================

# Encryption key for AES-256-GCM
# Generate with: node src/cli-store.js generate-key
# Must be 32-byte base64-encoded string
ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here


# ============================================================================
# SQLITE LOCAL DATABASE (Development - No additional vars needed)
# ============================================================================

# Optional: Specify database file path (default: env-secrets.db)
# SQLITE_DB_PATH=env-secrets.db


# ============================================================================
# SSH FILE STORAGE (Remote Server: 134.185.111.151)
# ============================================================================

# SSH connection details
SSH_HOST=134.185.111.151
SSH_USER=ubuntu
SSH_PORT=22
SSH_KEY=/Users/user/.ssh/id_rsa

# Remote database file path on server
REMOTE_DB_PATH=/home/ubuntu/env-secrets.json


# ============================================================================
# FIREBASE FIRESTORE (Cloud)
# ============================================================================

# Firebase project ID
# Create project at: https://console.firebase.google.com
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase service account key JSON file
# Generate at: Project Settings → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-serviceAccountKey.json


# ============================================================================
# POSTGRESQL (Enterprise - Not yet implemented)
# ============================================================================

# PostgreSQL connection details (when implemented)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_DATABASE=env_secrets


# ============================================================================
# AWS DYNAMODB (AWS Native - Not yet implemented)
# ============================================================================

# AWS credentials (when implemented)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# DYNAMODB_TABLE_NAME=env-secrets


# ============================================================================
# AUDIT & LOGGING (Optional)
# ============================================================================

# Current user/process name for access logs
# Default: $USER environment variable
USER=your-app-name

# IP address for logging (optional, for network access tracking)
# LOGGING_IP_ADDRESS=192.168.1.1


# ============================================================================
# BACKUP & EXPORT (Optional)
# ============================================================================

# Export/backup encryption key (different from main ENCRYPTION_KEY)
# Generate with: node src/cli-store.js generate-key
# EXPORT_ENCRYPTION_KEY=another-base64-key-for-exports

# Backup directory
# BACKUP_DIR=./backups

# Auto-backup interval (in hours)
# BACKUP_INTERVAL=24


# ============================================================================
# KEY ROTATION (Optional)
# ============================================================================

# Schedule for automatic key rotation
# KEY_ROTATION_INTERVAL=90  # days


# ============================================================================
# COMPLIANCE & SECURITY (Optional)
# ============================================================================

# Enable strict mode (additional security checks)
# STRICT_MODE=true

# Enable access log retention (in days)
# LOG_RETENTION_DAYS=90

# Environment name for logging
# ENVIRONMENT=production


# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Enable verbose logging
# DEBUG=true

# Enable test mode (use test database)
# TEST_MODE=false

# Local database cache file (for SSH mode)
# LOCAL_CACHE_FILE=.env-cache.json
